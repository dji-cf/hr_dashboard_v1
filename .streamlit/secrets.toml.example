# Local development secrets for `streamlit run` ONLY.
# Copy to `.streamlit/secrets.toml` and fill in. NEVER commit secrets.toml.
#
# IMPORTANT: The restricted caller's-rights connection ("snowflake-callers-rights")
# CANNOT run locally - it only works in the Streamlit-in-Snowflake container runtime.
# Locally the app falls back to this owner connection ("snowflake"), which sees MASKED
# data for your role. Use local runs for UI/import validation only, not tie-out.

[connections.snowflake]
account = "vxb09319.us-east-1"
user = "DJI"
authenticator = "externalbrowser"   # SSO browser login
warehouse = "ANALYTICS_WAREHOUSE"
database = "ORACLE_DATA_PROD"
schema = "SANDBOX"
